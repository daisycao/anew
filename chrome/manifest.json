{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.3.2",
  "description": "__MSG_appDesc__",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "nativeMessaging",
    "contextMenus"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "lib/Readability.js",
        "lib/turndown.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-panel": {
      "description": "__MSG_cmdToggle__"
    },
    "note-selection": {
      "description": "__MSG_cmdNote__"
    }
  },
  "default_locale": "en"
}